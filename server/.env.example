# 复制为 .env 后按需修改
PORT=3001

# 生产必须改为强随机串,可用: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=duitang-dev-secret-key-change-in-production

# 前端域名白名单,逗号分隔,如 https://duitang.example.com,http://localhost:5173
FRONTEND_ORIGIN=

# 上传目录,默认 server/uploads
UPLOAD_DIR=

# 日志级别: trace/debug/info/warn/error
LOG_LEVEL=info

# SQLite 路径,默认 server/database.sqlite
DB_PATH=

# 管理员用户名,逗号分隔(默认 tangyan)
ADMIN_USERNAMES=tangyan

# 敏感词,逗号分隔;留空则使用内置演示词表
SENSITIVE_WORDS=

# 关闭限流(仅开发/测试用,设为 1)
RATE_LIMIT_DISABLED=

# 图片防盗链:设为 1 后图片需带 HMAC 签名访问
UPLOAD_HOTLINK_PROTECT=
# 图片防盗链:设为 1 后校验 Referer(同源自动放行)
UPLOAD_REFERER_CHECK=
# Referer 白名单,逗号分隔
UPLOAD_REFERER_WHITELIST=
# 签名密钥,留空则回落到 JWT_SECRET
UPLOAD_SIGN_SECRET=

# 水印文案
WATERMARK_TEXT=堆糖 duitang
